rules_version = '2';
// อัปโหลดจากหลังบ้านต้องใช้ adminStorage (จาก admin app) เพื่อให้ request.auth เป็น admin ที่ล็อกอิน
// การเช็ก role อ่านจาก Firestore users/{uid} (cross-service rules)
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin'];
    }

    // รับเฉพาะไฟล์รูปภาพ และจำกัดขนาด
    function isImageUnder(maxMb) {
      return request.resource != null &&
        request.resource.contentType.matches('image/.*') &&
        request.resource.size < maxMb * 1024 * 1024;
    }

    // properties: รูปทรัพย์ปัจจุบันอัปโหลดผ่าน Cloudinary — เปิดให้เฉพาะ Admin
    match /properties/{propertyId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
    // hero_slides: อ่านได้ทุกคน, เขียนได้เฉพาะ Admin
    match /hero_slides/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
    // popular_locations: อ่านได้ทุกคน, เขียนได้เฉพาะ Admin
    match /popular_locations/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
    // pending_properties: ฟอร์มลงประกาศสาธารณะ — ใครก็อัปโหลดได้ แต่ต้องเป็นรูป ≤10MB
    // และห้ามเขียนทับ/ลบไฟล์เดิม (ลบได้เฉพาะ Admin)
    match /pending_properties/{pendingId}/{fileName} {
      allow read: if true;
      allow create: if isImageUnder(10);
      allow update: if false;
      allow delete: if isAdmin();
    }
    // blogs: อ่านได้ทุกคน, เขียนได้เฉพาะ Admin
    match /blogs/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
    // agents: อ่านได้ทุกคน, เขียนได้เฉพาะเจ้าของโฟลเดอร์ (รูปเท่านั้น)
    match /agents/{userId}/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == userId && isImageUnder(10);
      allow delete: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    // portfolio: อ่านได้ทุกคน, เขียนได้เฉพาะ Admin
    match /portfolio/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isImageUnder(15);
      allow delete: if isAdmin();
    }
    // messenger/: เขียนผ่าน Cloud Functions เท่านั้น (เปิดรูปผ่านลิงก์ที่มี token)
    // path อื่นที่ไม่ได้ระบุไว้ = ปฏิเสธทั้งหมดโดยปริยาย
  }
}
